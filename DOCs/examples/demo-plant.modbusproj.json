{
  "schemaVersion": 1,
  "name": "demo-plant",
  "description": "Демонстрационный проект: резервуар и частотный привод по Modbus TCP",
  "addressBase": 0,
  "opcua": {
    "endpointUrl": "opc.tcp://0.0.0.0:4840",
    "applicationName": "OPC_SERVER Demo Plant",
    "securityPolicy": "None",
    "securityMode": "None",
    "namespaceUri": "urn:opc-server:demo-plant"
  },
  "endpoints": [
    {
      "id": "plc-line-a",
      "host": "192.168.10.11",
      "port": 502,
      "transport": "tcp",
      "connectTimeoutMs": 3000,
      "responseTimeoutMs": 800,
      "reconnectDelayMs": 2000
    },
    {
      "id": "vfd-line-a",
      "host": "192.168.10.21",
      "port": 502,
      "transport": "tcp",
      "connectTimeoutMs": 3000,
      "responseTimeoutMs": 800,
      "reconnectDelayMs": 2000
    }
  ],
  "deviceProfiles": [
    {
      "id": "generic-tank-sensor",
      "name": "Generic tank sensor block",
      "vendor": "Demo",
      "description": "Типовая карта: уровень float, температура float, статус word",
      "tags": [
        {
          "name": "Tank1.Level",
          "nodePath": "Plant/Tank1/Level",
          "area": "holding",
          "address": 0,
          "type": "float32",
          "byteOrder": "ABCD",
          "scale": 1.0,
          "offset": 0.0,
          "unit": "m",
          "writable": false,
          "group": "tank1-fast",
          "description": "Уровень жидкости"
        },
        {
          "name": "Tank1.Temperature",
          "nodePath": "Plant/Tank1/Temperature",
          "area": "holding",
          "address": 2,
          "type": "float32",
          "byteOrder": "CDAB",
          "scale": 1.0,
          "offset": 0.0,
          "unit": "°C",
          "writable": false,
          "group": "tank1-fast",
          "description": "Температура"
        },
        {
          "name": "Tank1.Status",
          "nodePath": "Plant/Tank1/Status",
          "area": "holding",
          "address": 4,
          "type": "uint16",
          "byteOrder": "AB",
          "writable": false,
          "group": "tank1-slow",
          "description": "Битовая маска статуса"
        }
      ]
    }
  ],
  "devices": [
    {
      "id": "tank1",
      "endpointId": "plc-line-a",
      "unitId": 1,
      "profileId": "generic-tank-sensor",
      "description": "Резервуар №1",
      "tags": [
        {
          "name": "Tank1.Level",
          "nodePath": "Plant/Tank1/Level",
          "area": "holding",
          "address": 0,
          "type": "float32",
          "byteOrder": "ABCD",
          "scale": 1.0,
          "offset": 0.0,
          "unit": "m",
          "writable": false,
          "group": "tank1-fast",
          "description": "Уровень жидкости"
        },
        {
          "name": "Tank1.Temperature",
          "nodePath": "Plant/Tank1/Temperature",
          "area": "holding",
          "address": 2,
          "type": "float32",
          "byteOrder": "CDAB",
          "scale": 1.0,
          "offset": 0.0,
          "unit": "°C",
          "writable": false,
          "group": "tank1-fast",
          "description": "Температура"
        },
        {
          "name": "Tank1.Status",
          "nodePath": "Plant/Tank1/Status",
          "area": "holding",
          "address": 4,
          "type": "uint16",
          "byteOrder": "AB",
          "writable": false,
          "group": "tank1-slow",
          "description": "Битовая маска статуса"
        },
        {
          "name": "Tank1.Setpoint",
          "nodePath": "Plant/Tank1/Setpoint",
          "area": "holding",
          "address": 5,
          "type": "uint16",
          "byteOrder": "AB",
          "scale": 0.1,
          "offset": 0.0,
          "unit": "m",
          "writable": true,
          "group": "tank1-slow",
          "description": "Уставка уровня (запись из SCADA)"
        }
      ]
    },
    {
      "id": "vfd1",
      "endpointId": "vfd-line-a",
      "unitId": 1,
      "description": "Частотный привод насоса",
      "tags": [
        {
          "name": "Vfd1.Frequency",
          "nodePath": "Plant/Pump1/Vfd/Frequency",
          "area": "holding",
          "address": 100,
          "type": "float32",
          "byteOrder": "ABCD",
          "unit": "Hz",
          "writable": false,
          "group": "vfd1-fast"
        },
        {
          "name": "Vfd1.SpeedSetpoint",
          "nodePath": "Plant/Pump1/Vfd/SpeedSetpoint",
          "area": "holding",
          "address": 102,
          "type": "float32",
          "byteOrder": "ABCD",
          "unit": "Hz",
          "writable": true,
          "group": "vfd1-fast"
        },
        {
          "name": "Vfd1.Running",
          "nodePath": "Plant/Pump1/Vfd/Running",
          "area": "coil",
          "address": 0,
          "type": "bool",
          "writable": false,
          "group": "vfd1-fast"
        }
      ]
    }
  ],
  "pollGroups": [
    {
      "id": "tank1-fast",
      "periodMs": 200,
      "priority": "fast",
      "deviceId": "tank1",
      "blocks": [
        {
          "area": "holding",
          "start": 0,
          "count": 4,
          "description": "Level + Temperature (2+2 регистра)"
        }
      ]
    },
    {
      "id": "tank1-slow",
      "periodMs": 1000,
      "priority": "slow",
      "deviceId": "tank1",
      "blocks": [
        {
          "area": "holding",
          "start": 4,
          "count": 2,
          "description": "Status + Setpoint"
        }
      ]
    },
    {
      "id": "vfd1-fast",
      "periodMs": 100,
      "priority": "fast",
      "deviceId": "vfd1",
      "tagNames": [
        "Vfd1.Frequency",
        "Vfd1.SpeedSetpoint",
        "Vfd1.Running"
      ]
    }
  ]
}
