{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange-hanter.github.io/OPC_SERVER/schemas/modbus-project.schema.json",
  "title": "OPC_SERVER Modbus Project",
  "description": "Проект карты Modbus и маппинга в OPC UA (*.modbusproj.json)",
  "type": "object",
  "required": ["schemaVersion", "name", "endpoints", "devices", "pollGroups"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Версия формата проекта"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Имя проекта / площадки"
    },
    "description": {
      "type": "string"
    },
    "addressBase": {
      "type": "integer",
      "enum": [0, 1],
      "default": 0,
      "description": "База адресации регистров в проекте"
    },
    "opcua": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpointUrl": {
          "type": "string",
          "minLength": 1,
          "description": "Например opc.tcp://0.0.0.0:4840"
        },
        "applicationName": {
          "type": "string"
        },
        "securityPolicy": {
          "type": "string",
          "enum": ["None", "Basic256Sha256"],
          "default": "None"
        },
        "securityMode": {
          "type": "string",
          "enum": ["None", "Sign", "SignAndEncrypt"],
          "default": "None"
        },
        "namespaceUri": {
          "type": "string",
          "description": "URI пользовательского namespace"
        },
        "allowAnonymous": {
          "type": "boolean",
          "default": true,
          "description": "Разрешить Anonymous IdentityToken. При наличии users по умолчанию false"
        },
        "allowNonePassword": {
          "type": "boolean",
          "default": false,
          "description": "Лаборатория: username/password при securityMode None (иначе start() откажется)"
        },
        "allowCertificateIdentity": {
          "type": "boolean",
          "default": false,
          "description": "Разрешить X509IdentityToken; проверка через sessionPKI (--ua-trust / CRL)"
        },
        "allowNoneCertificate": {
          "type": "boolean",
          "default": false,
          "description": "Лаборатория: X509IdentityToken при securityMode None (иначе start() откажется)"
        },
        "users": {
          "type": "array",
          "description": "Список UsernameIdentityToken (open62541 AccessControl_default)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["username", "password"],
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "deviceProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviceProfile" }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/device" }
    },
    "pollGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pollGroup" }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["id", "host", "port", "transport"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "transport": { "type": "string", "enum": ["tcp", "udp"] },
        "connectTimeoutMs": { "type": "integer", "minimum": 1, "default": 3000 },
        "responseTimeoutMs": { "type": "integer", "minimum": 1, "default": 1000 },
        "reconnectDelayMs": { "type": "integer", "minimum": 0, "default": 2000 }
      }
    },
    "deviceProfile": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "vendor": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/tag" }
        }
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "endpointId", "unitId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "endpointId": { "type": "string", "minLength": 1 },
        "unitId": { "type": "integer", "minimum": 0, "maximum": 255 },
        "profileId": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/tag" }
        }
      }
    },
    "tag": {
      "type": "object",
      "required": ["name", "area", "address", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nodePath": {
          "type": "string",
          "description": "Путь в дереве OPC UA относительно Objects"
        },
        "area": {
          "type": "string",
          "enum": ["holding", "input", "coil", "discrete"]
        },
        "address": { "type": "integer", "minimum": 0 },
        "type": {
          "type": "string",
          "enum": ["bool", "uint16", "int16", "uint32", "int32", "float32", "float64"]
        },
        "quantity": { "type": "integer", "minimum": 1 },
        "byteOrder": {
          "type": "string",
          "enum": ["ABCD", "CDAB", "BADC", "DCBA", "AB", "BA"],
          "description": "Порядок байт/слов; для 16-бит — AB/BA"
        },
        "scale": { "type": "number", "default": 1 },
        "offset": { "type": "number", "default": 0 },
        "unit": { "type": "string" },
        "writable": { "type": "boolean", "default": false },
        "group": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "registerBlock": {
      "type": "object",
      "required": ["area", "start", "count"],
      "additionalProperties": false,
      "properties": {
        "area": {
          "type": "string",
          "enum": ["holding", "input", "coil", "discrete"]
        },
        "start": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1, "maximum": 125 },
        "description": { "type": "string" }
      }
    },
    "pollGroup": {
      "type": "object",
      "required": ["id", "periodMs", "priority", "deviceId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "periodMs": { "type": "integer", "minimum": 10 },
        "priority": {
          "type": "string",
          "enum": ["fast", "normal", "slow"]
        },
        "deviceId": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/registerBlock" }
        },
        "tagNames": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Альтернатива blocks: опрашивать перечисленные теги устройства"
        }
      }
    }
  }
}
